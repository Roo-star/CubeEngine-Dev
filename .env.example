OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
CUBEENGINE_LLM_OPENROUTER_MODEL=openai/gpt-6-sol
# Copy to the repository-root .env, then replace this ONE key.
CUBEENGINE_LLM_REASONING_EFFORT=medium
CUBEENGINE_LLM_MAX_TOKENS=32768
CUBEENGINE_LLM_TIMEOUT_S=180
CUBEENGINE_LLM_CHAT_RETRIES=2
CUBEENGINE_LLM_MAX_REQUESTS=12
