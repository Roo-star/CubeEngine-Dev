{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeengine.local/schema/asset-ir-patch.schema.json",
  "title": "CubeEngine Asset IR v2 Patch Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "base_revision", "base_content_hash", "operations", "evidence", "assumptions", "unresolved"],
  "properties": {
    "document_id": {"type": "string", "pattern": "^asset:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["op", "path"],
        "properties": {
          "op": {"enum": ["add", "remove", "replace", "move", "copy", "test"]},
          "path": {"type": "string"}, "from": {"type": "string"}, "value": {}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assumptions": {"type": "array"},
    "unresolved": {"type": "array"}
  }
}
