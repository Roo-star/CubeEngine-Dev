{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeengine.dev/schema/scene-ir-v2.schema.json",
  "title": "CubeEngine Scene IR v2",
  "type": "object",
  "required": [
    "ir_version", "document_id", "revision", "content_hash", "metadata",
    "dependencies", "layers", "prefabs", "nodes", "bindings",
    "provenance", "unresolved"
  ],
  "properties": {
    "ir_version": {"const": "cubeengine.scene-ir/2.0-alpha.1"},
    "document_id": {"$ref": "#/$defs/sceneId"},
    "revision": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "metadata": {
      "type": "object",
      "required": ["title", "description", "source_project_hash"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "source_project_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "required": ["rule_ir", "asset_ir", "extensions"],
      "properties": {
        "rule_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/documentPin"}]},
        "asset_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/documentPin"}]},
        "extensions": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^extension:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?:/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*)+/[1-9][0-9]*(?:\\.[0-9]+){0,2}$"}
        }
      },
      "additionalProperties": false
    },
    "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
    "prefabs": {"type": "array", "items": {"$ref": "#/$defs/prefab"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "provenance": {"type": "object"},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sceneId": {"type": "string", "pattern": "^scene:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "documentPin": {
      "type": "object",
      "required": ["document_id", "content_hash"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^(?:rule|asset):[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "vector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "matrix4": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {"type": "number"}
    },
    "transform": {
      "type": "object",
      "required": ["translation", "rotation_euler_deg", "scale"],
      "properties": {
        "translation": {"$ref": "#/$defs/vector3"},
        "rotation_euler_deg": {"$ref": "#/$defs/vector3"},
        "scale": {"$ref": "#/$defs/vector3"}
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "kind", "visible", "pickable", "opacity"],
      "properties": {
        "id": {"$ref": "#/$defs/sceneId"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["runtime", "editor"]},
        "visible": {"type": "boolean"},
        "pickable": {"type": "boolean"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "type", "enabled", "properties"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "type": {"enum": ["renderer", "camera", "light", "collider", "topology_visualizer", "rule_entity_visualizer", "ui_canvas", "authoring_marker"]},
        "enabled": {"type": "boolean"},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "parent", "active", "layer", "transform", "components"],
      "properties": {
        "id": {"$ref": "#/$defs/sceneId"},
        "name": {"type": "string", "minLength": 1},
        "parent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sceneId"}]},
        "active": {"type": "boolean"},
        "layer": {"$ref": "#/$defs/sceneId"},
        "transform": {"$ref": "#/$defs/transform"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
        "prefab": {"$ref": "#/$defs/sceneId"},
        "overrides": {"type": "object"},
        "editor": {"type": "object"}
      },
      "additionalProperties": false
    },
    "prefabNode": {
      "type": "object",
      "required": ["local_id", "name", "active", "transform", "components", "children"],
      "properties": {
        "local_id": {"$ref": "#/$defs/localId"},
        "name": {"type": "string", "minLength": 1},
        "active": {"type": "boolean"},
        "transform": {"$ref": "#/$defs/transform"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
        "children": {"type": "array", "items": {"$ref": "#/$defs/prefabNode"}}
      },
      "additionalProperties": false
    },
    "prefab": {
      "type": "object",
      "required": ["id", "name", "root"],
      "properties": {
        "id": {"$ref": "#/$defs/sceneId"},
        "name": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/prefabNode"}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["id", "name", "source", "target", "transform"],
      "properties": {
        "id": {"$ref": "#/$defs/sceneId"},
        "name": {"type": "string", "minLength": 1},
        "source": {"type": "object"},
        "target": {"type": "object"},
        "transform": {"type": "object"}
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": ["path", "reason", "required", "owner"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "reason": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "owner": {"type": "string", "minLength": 1},
        "evidence": {}
      },
      "additionalProperties": true
    }
  }
}
