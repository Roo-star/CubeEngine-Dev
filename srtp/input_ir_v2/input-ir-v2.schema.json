{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeengine.local/schema/input-ir-v2.schema.json",
  "title": "CubeEngine Input IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version", "document_id", "revision", "content_hash", "metadata",
    "dependencies", "contexts", "intents", "bindings", "provenance", "unresolved"
  ],
  "properties": {
    "ir_version": {"const": "cubeengine.input-ir/2.0-alpha.1"},
    "document_id": {"$ref": "#/$defs/inputId"},
    "revision": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "source_project_hash"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "source_project_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      }
    },
    "dependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_ir", "extensions"],
      "properties": {
        "rule_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rulePin"}]},
        "extensions": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^extension:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?:/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*)+/[1-9][0-9]*(?:\\.[0-9]+){0,2}$"}
        }
      }
    },
    "contexts": {"type": "array", "items": {"$ref": "#/$defs/context"}},
    "intents": {"type": "array", "items": {"$ref": "#/$defs/intent"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "provenance": {"type": "object"},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}
  },
  "$defs": {
    "inputId": {"type": "string", "pattern": "^input:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "ruleId": {"type": "string", "pattern": "^rule:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "rulePin": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "content_hash"],
      "properties": {
        "document_id": {"$ref": "#/$defs/ruleId"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "priority", "enabled_by_default", "focus", "consume_policy", "exclusive_group"],
      "properties": {
        "id": {"$ref": "#/$defs/inputId"},
        "name": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"},
        "enabled_by_default": {"type": "boolean"},
        "focus": {"enum": ["global", "viewport", "ui", "text_entry"]},
        "consume_policy": {"enum": ["binding", "first_match", "all_events"]},
        "exclusive_group": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/local"}]}
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "value_type", "required", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/inputId"},
        "name": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["digital", "scalar", "vector2", "pointer", "text"]},
        "required": {"type": "boolean"},
        "target": {"$ref": "#/$defs/target"}
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "semantic"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "action", "parameters"],
          "properties": {
            "kind": {"const": "rule_action"},
            "action": {"$ref": "#/$defs/ruleId"},
            "parameters": {
              "type": "object", "additionalProperties": {"$ref": "#/$defs/parameterSource"}
            }
          }
        }
      ]
    },
    "parameterSource": {
      "type": "object", "required": ["source"],
      "properties": {
        "source": {"enum": ["constant", "intent_value", "event_value", "event_position", "event_delta", "event_data"]},
        "value": {},
        "key": {"$ref": "#/$defs/local"},
        "value_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "controlRef": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "control"],
      "properties": {
        "device": {"enum": ["keyboard", "mouse", "touch", "gamepad", "gesture"]},
        "control": {"$ref": "#/$defs/local"}
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "device", "control", "phase", "modifiers", "modifier_policy"],
          "properties": {
            "kind": {"const": "control"},
            "device": {"enum": ["keyboard", "mouse", "touch", "gamepad", "gesture"]},
            "control": {"$ref": "#/$defs/local"},
            "phase": {"enum": ["press", "release", "repeat", "hold", "axis", "move", "scroll", "gesture", "text"]},
            "modifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local"}},
            "modifier_policy": {"enum": ["exact", "at_least"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "controls", "trigger", "phase", "modifiers", "modifier_policy"],
          "properties": {
            "kind": {"const": "chord"},
            "controls": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/controlRef"}},
            "trigger": {"$ref": "#/$defs/controlRef"},
            "phase": {"enum": ["press", "release", "repeat", "hold"]},
            "modifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local"}},
            "modifier_policy": {"enum": ["exact", "at_least"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "negative", "positive", "phases", "scale"],
          "properties": {
            "kind": {"const": "axis_composite"},
            "negative": {"$ref": "#/$defs/controlRef"},
            "positive": {"$ref": "#/$defs/controlRef"},
            "phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["press", "release", "repeat", "hold"]}},
            "scale": {"type": "integer", "minimum": 1, "maximum": 32767}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "up", "down", "left", "right", "phases", "scale"],
          "properties": {
            "kind": {"const": "vector2_composite"},
            "up": {"$ref": "#/$defs/controlRef"},
            "down": {"$ref": "#/$defs/controlRef"},
            "left": {"$ref": "#/$defs/controlRef"},
            "right": {"$ref": "#/$defs/controlRef"},
            "phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["press", "release", "repeat", "hold"]}},
            "scale": {"type": "integer", "minimum": 1, "maximum": 32767}
          }
        }
      ]
    },
    "processing": {
      "type": "object", "additionalProperties": false,
      "required": ["dead_zone", "sensitivity_numerator", "sensitivity_denominator", "invert", "clamp_min", "clamp_max"],
      "properties": {
        "dead_zone": {"type": "integer", "minimum": 0, "maximum": 32767},
        "sensitivity_numerator": {"type": "integer", "minimum": 1},
        "sensitivity_denominator": {"type": "integer", "minimum": 1},
        "invert": {"type": "boolean"},
        "clamp_min": {"type": "integer", "minimum": -32768, "maximum": 32767},
        "clamp_max": {"type": "integer", "minimum": -32768, "maximum": 32767}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "name", "context", "intent", "priority", "enabled", "consume",
        "rebindable", "slot", "accessibility_label", "trigger", "processing"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/inputId"},
        "name": {"type": "string", "minLength": 1},
        "context": {"$ref": "#/$defs/inputId"},
        "intent": {"$ref": "#/$defs/inputId"},
        "priority": {"type": "integer"},
        "enabled": {"type": "boolean"},
        "consume": {"type": "boolean"},
        "rebindable": {"type": "boolean"},
        "slot": {"enum": ["primary", "secondary", "accessibility"]},
        "accessibility_label": {"type": "string"},
        "trigger": {"$ref": "#/$defs/trigger"},
        "processing": {"$ref": "#/$defs/processing"}
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "reason", "required", "owner"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "owner": {"enum": ["importer", "adapter", "designer", "llm", "extension"]}
      }
    }
  }
}
