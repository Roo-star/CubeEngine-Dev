{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeengine.local/schema/project-manifest-v2.schema.json",
  "title": "CubeEngine Project Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "project_id", "revision", "content_hash", "metadata",
    "variant", "source_manifest", "documents", "extensions", "provenance", "unresolved"
  ],
  "properties": {
    "manifest_version": {"const": "cubeengine.project-manifest/2.0-alpha.2"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "revision": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "variant": {"enum": ["source", "target"]},
    "source_manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/manifestPin"}]},
    "documents": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_ir", "scene_ir", "asset_ir", "input_ir"],
      "properties": {
        "rule_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rulePin"}]},
        "scene_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scenePin"}]},
        "asset_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/assetPin"}]},
        "input_ir": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/inputPin"}]}
      }
    },
    "extensions": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/extensionPin"}
    },
    "provenance": {"type": "object"},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}
  },
  "$defs": {
    "projectId": {"type": "string", "pattern": "^project:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifestPin": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "content_hash"],
      "properties": {
        "project_id": {"$ref": "#/$defs/projectId"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "extensionPin": {
      "type": "object", "additionalProperties": false,
      "required": ["extension_id", "version", "content_hash"],
      "properties": {
        "extension_id": {"type": "string", "pattern": "^extension:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "pinBase": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "ir_version", "content_hash"],
      "properties": {
        "document_id": {"type": "string"},
        "ir_version": {"type": "string"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "rulePin": {
      "allOf": [
        {"$ref": "#/$defs/pinBase"},
        {"properties": {
          "document_id": {"type": "string", "pattern": "^rule:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "ir_version": {"const": "cubeengine.rule-ir/2.0-alpha.1"}
        }}
      ]
    },
    "scenePin": {
      "allOf": [
        {"$ref": "#/$defs/pinBase"},
        {"properties": {
          "document_id": {"type": "string", "pattern": "^scene:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "ir_version": {"const": "cubeengine.scene-ir/2.0-alpha.1"}
        }}
      ]
    },
    "assetPin": {
      "allOf": [
        {"$ref": "#/$defs/pinBase"},
        {"properties": {
          "document_id": {"type": "string", "pattern": "^asset:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "ir_version": {"const": "cubeengine.asset-ir/2.0-alpha.1"}
        }}
      ]
    },
    "inputPin": {
      "allOf": [
        {"$ref": "#/$defs/pinBase"},
        {"properties": {
          "document_id": {"type": "string", "pattern": "^input:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "ir_version": {"const": "cubeengine.input-ir/2.0-alpha.1"}
        }}
      ]
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "reason", "required", "owner"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "owner": {"enum": ["importer", "adapter", "designer", "llm", "extension"]}
      }
    }
  }
}
