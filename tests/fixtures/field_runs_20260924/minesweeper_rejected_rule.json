  ],
  "behavior_tests": [
    {
      "name": "Right-click flags an unopened tile",
      "steps": [
        {
          "action": "rule:action.cycle_mark",
          "parameters": {
            "coordinate": [
              0,
              0
            ]
          },
          "accepted": true
        }
      ],
      "expect": {
        "cells": [
          {
            "state": "rule:state.cover",
            "coordinate": [
              0,
              0
            ],
            "value": 1
          }
        ],
        "terminal": false
      }
    },
    {
      "name": "A flagged tile cannot be directly revealed",
      "steps": [
        {
          "action": "rule:action.cycle_mark",
          "parameters": {
            "coordinate": [
              0,
              0
            ]
          },
          "accepted": true
        },
        {
          "action": "rule:action.reveal",
          "parameters": {
            "coordinate": [
              0,
              0
            ]
          },
          "accepted": false
        }
      ],
      "expect": {
        "cells": [
          {
