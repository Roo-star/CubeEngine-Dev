  "accepted_stages": {
    "rule_ir": {
      "definition": {
        "metadata": {
          "title": "Tic Tac Toe",
          "description": "Two alternating marks on a 3×3 board. Three in a row wins; filling the board without a winner draws. Restart clears the game.",
          "source_project_hash": "126c97294df6f4b2a889959917e957431d88431bb27df44d4dd743854058392a",
          "determinism": "deterministic"
        },
        "parameters": [],
        "types": [],
        "participants": [
          {
            "id": "rule:participant.human",
            "name": "Local player controlling both alternating marks",
            "kind": "human"
          }
        ],
        "topologies": [
          {
            "id": "rule:topology.board",
            "name": "3×3 board",
            "kind": "rect_grid",
            "anchor": "cell",
            "axes": [
              {
                "name": "x",
                "extent": 3,
                "boundary": "bounded"
              },
              {
                "name": "y",
                "extent": 3,
                "boundary": "bounded"
              }
            ],
            "neighborhoods": []
          }
        ],
        "state": {
          "variables": [
            {
              "id": "rule:state.board",
              "name": "Board cell: empty, X or O",
              "type": "core:int",
              "scope": "topology_site",
              "topology": "rule:topology.board",
              "initial": {
                "expr": "0"
              }
            },
            {
              "id": "rule:state.current_player",
              "name": "Mark whose turn it is",
              "type": "core:int",
              "scope": "global",
              "initial": {
                "expr": "1"
              }
            },
            {
              "id": "rule:state.winner",
              "name": "Winning mark, or zero",
              "type": "core:int",
              "scope": "global",
              "initial": {
                "expr": "0"
              }
            },
            {
              "id": "rule:state.draw",
              "name": "Whether the game is drawn",
              "type": "core:bool",
              "scope": "global",
              "initial": {
                "expr": "False"
              }
            }
          ],
          "entity_types": [],
          "initial_effects": [],
          "information_model": "perfect"
        },
        "queries": [],
        "events": [
          {
            "id": "rule:event.placed",
            "name": "Mark placed",
            "payload": []
          }
        ],
        "actions": [
          {
            "id": "rule:action.place",
            "name": "Place the current mark",
            "actor": {
              "expr": "'rule:participant.human'"
            },
            "parameters": [
              {
                "name": "coordinate",
                "type": "core:coord",
                "domain": {
                  "expr": "topology.sites('rule:topology.board')"
                }
              }
            ],
            "precondition": {
              "expr": "state.get('rule:state.winner') == 0 and state.get('rule:state.draw') == False and topology.contains('rule:topology.board', param.coordinate) and grid.get('rule:state.board', param.coordinate) == 0"
            },
            "effects": [
              {
                "op": "grid.set",
                "state": "rule:state.board",
                "coordinate": {
                  "expr": "param.coordinate"
                },
                "value": {
                  "expr": "state.get('rule:state.current_player')"
                }
              },
              {
                "op": "event.emit",
                "event": "rule:event.placed"
              }
            ],
            "timing": {
              "phase": "rule:phase.input"
            },
            "encoding": {
              "kind": "parameter_product"
            }
          },
          {
            "id": "rule:action.restart",
            "name": "Restart and clear the board",
            "actor": {
              "expr": "'rule:participant.human'"
            },
            "parameters": [],
            "precondition": {
              "expr": "True"
            },
            "effects": [
              {
                "op": "foreach",
                "query": {
                  "expr": "topology.sites('rule:topology.board')"
                },
                "as": "cell",
                "effects": [
                  {
                    "op": "grid.set",
                    "state": "rule:state.board",
                    "coordinate": {
                      "expr": "var.cell"
                    },
                    "value": {
                      "expr": "0"
                    }
                  }
                ]
              },
              {
                "op": "state.set",
                "target": {
                  "expr": "'rule:state.current_player'"
                },
                "value": {
                  "expr": "1"
                }
              },
              {
                "op": "state.set",
                "target": {
                  "expr": "'rule:state.winner'"
                },
                "value": {
                  "expr": "0"
                }
              },
              {
                "op": "state.set",
                "target": {
                  "expr": "'rule:state.draw'"
                },
                "value": {
                  "expr": "False"
                }
              }
            ],
            "timing": {
              "phase": "rule:phase.input"
            },
            "encoding": {
              "kind": "finite_catalogue"
            }
          }
        ],
        "systems": [
          {
            "id": "rule:system.win",
            "name": "Detect a completed row, column or diagonal",
            "phase": "rule:phase.input",
            "priority": 100,
            "trigger": {
              "kind": "event",
              "event": "rule:event.placed"
            },
            "condition": {
              "expr": "grid.has_line('rule:state.board', state.get('rule:state.current_player'), 3)"
            },
            "effects": [
              {
                "op": "state.set",
                "target": {
                  "expr": "'rule:state.winner'"
                },
                "value": {
                  "expr": "state.get('rule:state.current_player')"
                }
              }
            ]
          },
          {
            "id": "rule:system.draw",
            "name": "Detect a full board without a winner",
            "phase": "rule:phase.input",
            "priority": 200,
            "trigger": {
              "kind": "event",
              "event": "rule:event.placed"
            },
            "condition": {
              "expr": "state.get('rule:state.winner') == 0 and grid.count_equal('rule:state.board', 0) == 0"
            },
            "effects": [
              {
                "op": "state.set",
                "target": {
                  "expr": "'rule:state.draw'"
                },
                "value": {
                  "expr": "True"
                }
              }
            ]
          },
          {
            "id": "rule:system.next_player",
            "name": "Alternate marks unless the game ended",
            "phase": "rule:phase.input",
            "priority": 300,
            "trigger": {
              "kind": "event",
              "event": "rule:event.placed"
            },
            "condition": {
              "expr": "state.get('rule:state.winner') == 0 and state.get('rule:state.draw') == False"
            },
            "effects": [
              {
                "op": "state.set",
                "target": {
                  "expr": "'rule:state.current_player'"
                },
                "value": {
                  "expr": "3 - state.get('rule:state.current_player')"
                }
              }
            ]
          }
        ],
        "flow": {
          "model": "event_driven",
          "phases": [
            {
              "id": "rule:phase.input",
              "order": 100
            }
          ],
          "initial_phase": "rule:phase.input",
          "scheduler": {
            "clock": "event_queue",
            "tick_hz": null,
            "ordering": "phase_priority_id"
          }
        },
        "random_streams": [],
        "goals": [
          {
            "id": "rule:goal.three_in_row",
            "name": "Complete three of your marks in a row, column or diagonal"
          }
        ],
        "outcomes": [
          {
            "id": "rule:outcome.win",
            "name": "X or O wins",
            "priority": 100,
            "condition": {
              "expr": "state.get('rule:state.winner') != 0"
            },
            "result": {
              "status": "win",
              "terminal": true,
              "winner_state": "rule:state.winner"
            }
          },
          {
            "id": "rule:outcome.draw",
            "name": "Draw",
            "priority": 200,
            "condition": {
              "expr": "state.get('rule:state.draw') == True"
            },
            "result": {
              "status": "draw",
              "terminal": true
            }
          }
        ],
        "modes": [
          {
            "id": "rule:mode.default",
            "name": "Default",
            "overrides": []
          }
        ],
        "invariants": [
          {
            "id": "rule:invariant.current_player",
            "name": "Current mark is X or O",
            "condition": {
              "expr": "state.get('rule:state.current_player') == 1 or state.get('rule:state.current_player') == 2"
            },
            "severity": "error"
          },
          {
            "id": "rule:invariant.cell_values",
            "name": "All nine cells have valid values",
            "condition": {
              "expr": "grid.count_equal('rule:state.board', 0) + grid.count_equal('rule:state.board', 1) + grid.count_equal('rule:state.board', 2) == 9"
            },
            "severity": "error"
          }
        ],
        "extensions": {},
        "unresolved": []
      },
      "evidence": [
        "ev:param.source_grid_x.0",
